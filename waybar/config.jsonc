                    __/ |                                              __/ |
                   |___/                                              |___/ */


//═══════════════════════════════════════ Setting ════════════════════════════════════╗
{                                                                                   //║
  "reload_style_on_change": true,                                                   //║
  "layer": "top",                                                                   //║
  "output": "DP-1",                                                                 //║
  "position": "top",                                                                //║
  "spacing": 0,                                                                     //║
  "height": 37,                                                                     //║
  "margin-top": 0,                                                                  //║
  "margin-left": 0,                                                                 //║
  "margin-right": 0,                                                                //║
                                                                                    //║
//═══════════════════════════════════════ Setting ════════════════════════════════════╝

//═══════════════════════════════════════ Modules ════════════════════════════════════╗
                                                                                    //║
  "modules-left": [                                                                 //║
    "group/left1-expander",                                                         //║
    "custom/active_window"                                                          //║
  ],                                                                                //║
                                                                                    //║
  "modules-center": [                                                               //║
    "group/center3-expander",                                                       //║
    "hyprland/workspaces",                                                          //║
    "group/center2-expander"                                                        //║
  ],                                                                                //║
                                                                                    //║
  "modules-right": [                                                                //║
    "group/right1"                                                                  //║
  ],                                                                                //║
                                                                                    //║
//═══════════════════════════════════════ Modules ════════════════════════════════════╝

//═══════════════════════════════════════ Expand ═════════════════════════════════════╗
                                                                                    //║
  "group/left1-expander": {                                                         //║
    "orientation": "inherit",                                                       //║
    "drawer": {                                                                     //║
      "transition-duration": 600,                                                   //║
      "transition-left-to-right": true                                              //║
    },                                                                              //║
    "modules": [                                                                    //║
      "custom/launcher",                                                            //║
      "custom/separator#blank2",                                                    //║
      "tray",                                                                       //║
      "wlr/taskbar"                                                                 //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/center2": {                                                                //║
    "orientation": "inherit",                                                       //║
    "modules": [                                                                    //║
      "mpris",                                                                      //║
      "pulseaudio"                                                                  //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/center2-expander": {                                                       //║
    "orientation": "inherit",                                                       //║
    "drawer": {                                                                     //║
      "transition-duration": 600,                                                   //║
      "transition-left-to-right": false,                                            //║
      "children-class": "center2-group-item"                                        //║
    },                                                                              //║
    "modules": [                                                                    //║
      "custom/expand-iconr",                                                        //║
      "group/center2"                                                               //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/center3": {                                                                //║
    "orientation": "inherit",                                                       //║
    "modules": [                                                                    //║
      "clock#time",                                                                 //║
      "custom/separator#blank",                                                     //║
      "clock#date"                                                                  //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/center3-expander": {                                                       //║
    "orientation": "inherit",                                                       //║
    "drawer": {                                                                     //║
      "transition-duration": 600,                                                   //║
      "children-class": "center3-group-item"                                        //║
    },                                                                              //║
    "modules": [                                                                    //║
      "custom/expand-iconl",                                                        //║
      "group/center3"                                                               //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/right1": {                                                                 //║
    "orientation": "inherit",                                                       //║
    "modules": [                                                                    //║
      "group/right1-expander"                                                       //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
  "group/right1-expander": {                                                        //║
    "orientation": "inherit",                                                       //║
    "drawer": {                                                                     //║
      "transition-duration": 600,                                                   //║
      "transition-left-to-right": false                                             //║
    },                                                                              //║
    "modules": [                                                                    //║
      "custom/expand-right",                                                        //║
      "network",                                                                    //║
      "bluetooth",                                                                  //║
      "battery"                                                                     //║
    ]                                                                               //║
  },                                                                                //║
                                                                                    //║
//═══════════════════════════════════════ Expand ═════════════════════════════════════╝


//═══════════════════════════════════════ Icons ══════════════════════════════════════╗
                                                                                    //║
"custom/expand-iconl": { "format": "  ", "tooltip": false },                       //║
"custom/expand-right": { "format": "", "tooltip": false },                         //║
"custom/expand-iconr": { "format": "  ", "tooltip": false },                       //║
"custom/separator#blank": { "format": " ", "tooltip": false },                      //║
"custom/separator#blank2": { "format": "  ", "tooltip": false },                    //║
                                                                                    //║
//═══════════════════════════════════════ Icons ══════════════════════════════════════╝

//═══════════════════════════════════════ Left ═══════════════════════════════════════╗
                                                                                    //║
  "custom/launcher": {                                                              //║
      "format": "󰣇",                                                                //║
      "on-click": "exec kitty --title launcher l",                                  //║
      "tooltip": false                                                              //║
  },                                                                                //║
                                                                                    //║
  "tray": {                                                                         //║
    "icon-size": 16,                                                                //║
    "spacing": 8                                                                    //║
  },                                                                                //║
                                                                                    //║
  "wlr/taskbar": {                                                                  //║
      "format": "{icon}",                                                           //║
      "on-click": "activate",                                                       //║
      "on-click-middle": "close"                                                    //║
  },                                                                                //║
                                                                                    //║
//══════════════════════════════════════ Left ════════════════════════════════════════╝

//══════════════════════════════════════ Center ══════════════════════════════════════╗
                                                                                    //║
  "clock#time": {                                                                   //║
      "interval": 1,                                                                //║
      "format": " {:%H:%M:%S}",                                                    //║
      "on-click": "kitty --title clock tty-clock -sD",                              //║
      "tooltip": false                                                              //║
  },                                                                                //║
                                                                                    //║
  "clock#date": {                                                                   //║
      "tooltip": false,                                                             //║
      "interval": 60,                                                               //║
      "format": "󰸘 {:%d/%m}",                                                       //║
      "on-click": "kitty --title calander calcurse"                                 //║
  },                                                                                //║
                                                                                    //║
  "hyprland/workspaces": {                                                          //║
    "format": "{icon}",                                                             //║
    "on-click": "activate",                                                         //║
    "all-outputs": false,                                                           //║
    "format-icons": {"default": "", "active": "", "empty": ""},                  //║
    "persistent-workspaces": { "*": 5 }                                             //║
  },                                                                                //║
                                                                                    //║
  "mpris": {                                                                        //║
    "format": "󰎆 {title}",                                                          //║
    "format-paused": "󰏤 {title}",                                                   //║
    "max-length": 20,                                                               //║
    "min-length": 20,                                                               //║
    "tooltip": false                                                                //║
  },                                                                                //║
                                                                                    //║
  "pulseaudio": {                                                                   //║
    "max-length": 8,                                                                //║
    "min-length": 8,                                                                //║
    "scroll-step": 5,                                                               //║
    "format-muted": "󰝟",                                                            //║
    "format": "{volume}% {icon}",                                                   //║
    "format-bluetooth": "{volume}% ",                                              //║
    "on-click": "kitty --title wiremix wiremix",                                    //║
    "ignored-sinks": ["Easy Effects Sink"],                                         //║
    "format-icons": ["", "", "", ""]                                            //║
  },                                                                                //║
                                                                                    //║
//══════════════════════════════════════ Center ══════════════════════════════════════╝

//═══════════════════════════════════════ Right ══════════════════════════════════════╗
                                                                                    //║
  "bluetooth": {                                                                    //║
    "format": "󰂯 ",                                                                 //║
    "format-connected": "󰂱",                                                        //║
    "format-disabled": "󰂲",                                                         //║
    "tooltip-format": "Not connected",                                              //║
    "tooltip-format-connected": "{device_alias}",                                   //║
    "tooltip-format-enumerate-connected": "{device_alias}",                         //║
    "on-click": "kitty --title bluetui bluetui"                                     //║
  },                                                                                //║
                                                                                    //║
  "network": {                                                                      //║
    "format-wifi": " 󰤨 ",                                                           //║
    "format-ethernet": "󰈀",                                                         //║
    "format-disconnected": "󰤭",                                                     //║
    "tooltip-format-wifi": "{essid}  {signalStrength}%",                            //║
    "tooltip-format-ethernet": "{ifname}",                                          //║
    "tooltip-format-disconnected": "Not connected",                                 //║
    "on-click": "kitty --title impala impala",                                      //║
    "max-length": 20                                                                //║
  },                                                                                //║
                                                                                    //║
  "battery": {                                                                      //║
    "format": "{icon} {capacity}%",                                                 //║
    "format-charging": "󰂄 {capacity}%",                                             //║
    "format-plugged": "󰚥 {capacity}%",                                              //║
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],             //║
    "states": { "warning": 30, "critical": 15 },                                    //║
    "tooltip": false                                                                //║
  }                                                                                 //║
}                                                                                   //║
//═══════════════════════════════════════ Right ══════════════════════════════════════╝